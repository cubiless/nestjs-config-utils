{
  "name": "@cubiles/nestjs-config-utils",
  "private": false,
  "version": "11.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubiless/nestjs-config-utils.git"
  },
  "keywords": [
    "nestjs",
    "config",
    "validation",
    "env"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rimraf -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start:dev": "nest start -p tsconfig.json --watch",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/common": "^11.1.15",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.15",
    "@nestjs/platform-express": "11.1.15",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "js-yaml": "^4.1.1",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "reflect-metadata": "^0.2.2",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
